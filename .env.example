# Copy to .env.local for local development. Shell variables take precedence.
# Docker Compose reads this file only when passed --env-file .env.local.
NODE_ENV=development
DB_PORT=5433
DATABASE_URL=postgresql://crm:crm_pass@127.0.0.1:5433/atlascrm_local?schema=public
API_PORT=3000

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the generated value below. Never commit .env.local.
JWT_SECRET=
