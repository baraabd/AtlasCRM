# Copy to apps/crm-mobile/.env.local. Expo reads this app's environment files.
# Android Studio emulator: the API runs on the host computer at port 3000.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# For a physical phone, replace the URL with the computer's LAN IPv4 address.
# The phone and computer must be on a reachable local network.
# For release builds, set the deployed HTTPS API origin before building.
# Do not append /api (Swagger) or /v1; the client already supplies endpoint paths.
