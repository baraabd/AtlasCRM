generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. إدارة الشركات والمستخدمين
model Tenant {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("AGENT") // ADMIN, AGENT
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. البيانات الأساسية (Leads)
model Lead {
  id           String   @id // نستخدم String لنقبل UUID القادم من الموبايل
  name         String
  businessType String?
  phones       String[] @default([])
  address      String?
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft Delete للمزامنة

  visits       Visit[]
  deals        Deal[]
}

// 3. الزيارات (Visits)
model Visit {
  id          String    @id // UUID من الموبايل
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  outcome     VisitOutcome?
  notes       String?
  presented   Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  deals       Deal[]
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  visitId   String?

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visit     Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  stage     DealStage @default(NEW)
  value     Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum DealStage {
  NEW
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum VisitOutcome {
  FOLLOW_UP
  WON
  LOST
  NO_ACTION
}