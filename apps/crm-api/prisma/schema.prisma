generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Lead {
  id        String   @id @default(cuid())
  name      String
  category  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits    Visit[]
  deals     Deal[]
}

model Visit {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  durationSec Int?

  outcome     VisitOutcome?
  presented   Json?
  notes       String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  deals       Deal[]
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  visitId   String?

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visit     Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  stage     DealStage @default(NEW)
  value     Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum DealStage {
  NEW
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum VisitOutcome {
  FOLLOW_UP
  WON
  LOST
  NO_ACTION
}


